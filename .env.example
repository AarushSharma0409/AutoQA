# Demo mode has one local identity. Bind demo services to loopback only.
MODE=demo
DATABASE_URL=postgresql+psycopg://autoagent:autoagent@postgres:5432/autoagent
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/data/files
# Set both secrets to different random values of at least 32 characters for live mode.
AUTH_SECRET=
# Set supabase for account signup/login; local keeps the developer token workflow.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SANDBOX_SECRET=local-demo-broker-secret-change-before-live
AUTH_ISSUER=autoagent
AUTH_AUDIENCE=autoagent-api
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional; Groq GPT-OSS supports low, medium, high. Leave blank for other models.
LLM_REASONING_EFFORT=
SEARCH_API_KEY=
# Tavily supports rate-limited keyless search. Optional key uses your account quota.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SANDBOX_URL=http://sandbox:8001
MAX_STEPS=16
MAX_TOKENS=30000
MAX_SECONDS=600
MAX_COST=1.0
RATE_LIMIT_READS=600
RATE_LIMIT_WRITES=30
RATE_LIMIT_WINDOW=60
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=4
# Conservative configured estimate, not a provider invoice. Set for chosen model.
TOKEN_PRICE_PER_MILLION=10.0
